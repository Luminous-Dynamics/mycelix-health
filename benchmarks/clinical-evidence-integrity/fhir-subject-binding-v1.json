          "resourceType": "Observation",
          "id": "o-1"
        }
      },
      "selected_patient_id": "p-1",
      "entries": [
        {
          "fullUrl": "https://ehr.example/fhir/Patient/p-1",
          "resource": {
            "resourceType": "Patient",
            "id": "p-1"
          }
        }
      ],
      "expected_binding": "matches",
      "expected_ingest": "accept"
    },
