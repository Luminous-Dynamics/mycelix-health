  "benchmark_id": "mycelix-clinical-evidence-integrity.fhir-subject-binding.v1",
  "release_status": "fixture-corpus-only",
  "data_classification": "fully_synthetic_no_phi",
  "reference_standard": {
    "fhir_version": "4.0.1",
    "profile": "FHIR R4 Bundle reference-resolution subset",
    "resolution_policy": "exact Bundle identity; relative references expanded from referencing entry RESTful fullUrl; version-specific references require exact meta.versionId; unresolved or ambiguous bindings fail closed",
    "expected_outcome_semantics": {
      "accept": "exactly one Patient resource; all relevant RESTful fullUrl/resource identities agree; source entry is valid; subject reference resolves uniquely to the selected Patient",
      "reject": "any missing, malformed, ambiguous, wrong-version, wrong-resource, wrong-patient or internally inconsistent identity condition"
    }
  },
