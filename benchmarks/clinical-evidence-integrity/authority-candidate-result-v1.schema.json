{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/clinical-authority-candidate-result-v1.schema.json",
  "title": "Clinical Evidence Authority Benchmark Candidate Results v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "mycelix-clinical-evidence-integrity.authority-semantics.v1"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "decision",
          "reason_codes",
          "evidence_refs",
          "policy_version"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "deny"
                }
              }
            },
            "then": {
              "properties": {
                "reason_codes": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "allow"
                }
              }
            },
            "then": {
              "properties": {
                "reason_codes": {
                  "contains": {
                    "const": "authorized"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
