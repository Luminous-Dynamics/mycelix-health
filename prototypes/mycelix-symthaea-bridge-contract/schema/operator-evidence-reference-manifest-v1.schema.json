{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/health-evidence-reference-manifest-v1.schema.json",
  "title": "Operator-side Evidence Reference Manifest v1",
  "description": "Restricted manifest mapping candidate signals to source-bound evidence. Never included in candidate-visible episode payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "episode_id",
    "tenant_id",
    "subject_binding",
    "purpose",
    "recipient_id",
    "signals"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_binding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recipient_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalReference"
      }
    }
  },
  "$defs": {
    "signalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "outcome_id",
        "evidence"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "event_id",
        "source_principal",
        "source_connection_id",
        "resource_type",
        "resource_id",
        "resource_version",
        "payload_digest",
        "source_receipt_digest"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "source_receipt_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
