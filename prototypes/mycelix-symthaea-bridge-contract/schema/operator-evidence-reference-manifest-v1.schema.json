{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/health-evidence-reference-manifest-v1.schema.json",
  "title": "Operator-side Evidence Reference Manifest v1",
  "description": "Restricted manifest mapping candidate signals to source-bound evidence. Never included in candidate-visible episode payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "episode_id",
    "tenant_id",
    "subject_binding",
    "purpose",
    "recipient_id",
    "signals",
    "as_of_time_ms",
    "probes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_binding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recipient_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalReference"
      }
    },
    "as_of_time_ms": {
      "type": "integer"
    },
    "probes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probeReference"
      }
    }
  },
  "$defs": {
    "signalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "outcome_id",
        "evidence"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "event_id",
        "source_principal",
        "source_connection_id",
        "resource_type",
        "resource_id",
        "resource_version",
        "payload_digest",
        "source_receipt_digest",
        "clinical_event_time_ms",
        "specimen_collected_at_ms",
        "analysis_performed_at_ms",
        "result_issued_at_ms",
        "source_last_updated_at_ms",
        "source_sequence",
        "ingested_at_ms"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "source_receipt_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "clinical_event_time_ms": {
          "type": "integer"
        },
        "specimen_collected_at_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "analysis_performed_at_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "result_issued_at_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_last_updated_at_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ingested_at_ms": {
          "type": "integer"
        }
      }
    },
    "probeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "receipt_id",
        "action_id",
        "allowed_resource_types",
        "authority_receipt_digest",
        "expires_at_ms"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_resource_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "authority_receipt_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "expires_at_ms": {
          "type": "integer"
        }
      }
    }
  }
}
